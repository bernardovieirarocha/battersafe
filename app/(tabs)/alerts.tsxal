import React from 'react';
import { View, FlatList, Text, StyleSheet } from 'react-native';
import { Header } from '../../components/Header';
import { BRAND } from '../../constants/theme';

const ALERTS = [
  { id: '1', title: 'Carregamento Eficiente', color: BRAND.success, desc: 'Bom histórico recente.' },
  { id: '2', title: 'Operação Desbalanceada', color: BRAND.warn, desc: 'Diferença entre células acima do ideal.' },
  { id: '3', title: 'Temperatura Elevada', color: BRAND.danger, desc: 'Evite uso intenso acima de 40ºC.' },
];

export default function AlertsScreen() {
  return (
    <View style={{ flex: 1, backgroundColor: BRAND.grayBg }}>
      <Header title="Alertas"/>
      <FlatList
        data={ALERTS}
        keyExtractor={(i) => i.id}
        contentContainerStyle={{ padding: 16 }}
        renderItem={({ item }) => (
          <View style={styles.alertItem}>
            <View style={[styles.alertDot, { backgroundColor: item.color }]} />
            <View style={{ flex: 1 }}>
              <Text style={styles.alertTitle}>{item.title}</Text>
              <Text style={styles.alertDesc}>{item.desc}</Text>
            </View>
          </View>
        )}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  alertItem: { backgroundColor: 'white', borderRadius: 14, padding: 14, flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 12, elevation: 1 },
  alertDot: { width: 10, height: 10, borderRadius: 9999 },
  alertTitle: { fontWeight: '700', color: BRAND.text },
  alertDesc: { color: '#6b7280', marginTop: 2 },
});